---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
const { title = "Hackathon 2026" } = Astro.props;
import Footer from '../components/Footer.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body id="top" class="dark-mode">
    
    <a href="https://mlh.com" target="_blank" rel="noreferrer" class="mlh-banner">
      <img src="/mlh-banner.svg" alt="Major League Hacking Banner" />
    </a>
    <Navbar />

    <slot name="above-filter" /> <!-- outside the wrapper so no filter -->
    <div class="page-wrapper">
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <style is:global>
      :root { --transition-speed: 1.2s; }
      body { margin: 0; transition: background var(--transition-speed); }

      .page-wrapper {
        transition: filter var(--transition-speed); }

      .mlh-banner {
        position: fixed;
        top: 0;
        right: 80px;
        z-index: 10000;
        display: block;
        width: 80px;
      }

      .mlh-banner img {
        width: 100%;
        height: auto;
      }

    </style>
  </body>
</html>